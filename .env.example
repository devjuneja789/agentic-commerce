# Copy this file to server/.env and fill in real values.
# (Vite only exposes VITE_-prefixed vars to the client — see the client section below.)

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MongoDB (Atlas free tier) ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/agentic-catalog-paypal?retryWrites=true&w=majority

# --- PayPal (Sandbox mode from developer.paypal.com > Apps & Credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_MS=10000
PAYPAL_SIMULATE_FAILURE=false

# --- Guardrails ---
# Orders above MAX_ORDER_VALUE are rejected outright.
# Orders above APPROVAL_THRESHOLD (but under MAX_ORDER_VALUE) are created as
# pending_approval instead of auto-issuing a payment link. Values in smallest
# currency unit's major unit (e.g. rupees, not paise).
MAX_ORDER_VALUE=50000
APPROVAL_THRESHOLD=10000

# --- AI buyer agent ---
LLM_API_KEY=
LLM_PROVIDER=gemini
# Google's current stable Flash model for generateContent. Override here if
# this one gets deprecated — see https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.5-flash
# Milliseconds before a Gemini call is treated as timed out
LLM_TIMEOUT_MS=15000

# --- Merchant identity (optional, embedded in every catalog offer's `seller` field) ---
MERCHANT_ID=studio-loom
MERCHANT_NAME=Studio Loom

# --- Client (must be duplicated into client/.env, VITE_ prefix required) ---
VITE_API_BASE_URL=http://localhost:5000/api
